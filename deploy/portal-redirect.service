[Unit]
Description=门户 HTTP→HTTPS 跳转（80 → 443）
Documentation=file:///opt/portal/docs/portal-operations.md
After=network-online.target portal.service
Wants=network-online.target

[Service]
Type=simple
# 只做 80 → 443 跳转：降权到服务账号，仅保留绑定 80 的单项能力（审计 P2-11）
User=portal
Group=portal
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
WorkingDirectory=/opt/portal
ExecStart=/opt/portal/.venv/bin/python /opt/portal/scripts/tls_redirect.py --listen-port 80 --target-port 443
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
