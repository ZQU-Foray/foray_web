# 门户生产环境变量样例（阶段 7）
#
# 用法：复制到服务器 /opt/portal/.env，chmod 600，按实际值填写。
# 该文件**不入库**：真实 App Secret 只存在于服务器与该文件；
# config/feishu.json 里只写 `"app_secret_ref": "env:FEISHU_APP_SECRET"`。
#
# 键名与默认值全部对应 app/config.py（改这里等于改运行时行为，逐条核对再用）。

# ---------- 服务 ----------
WEB_HOST=0.0.0.0
WEB_PORT=80

# ---------- 飞书（企业自建应用）----------
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# 在飞书开放平台「凭证与基础信息」重置后填写；只放这里，不要粘进文档/截图
FEISHU_APP_SECRET=请填写真实密钥
# 必须与开放平台「安全设置 → 重定向 URL」完全一致，否则回调 code=2000
FEISHU_REDIRECT_URL=http://portal.example.com/auth/feishu/callback
# 组织校验：只允许本战队租户（tenant_key，逗号分隔可多个）
FEISHU_ALLOWED_TENANT_KEYS=<tenant_key>

# ---------- 门户同步（阶段 4/5）----------
PORTAL_SYNC_ENABLED=1
# 前端：vue（默认，static/app/ 构建产物）| legacy（回退旧版原生前端，改完重启 portal.service 即生效）
PORTAL_FRONTEND=vue
PORTAL_SYNC_INTERVAL=60
PORTAL_MANUAL_MIN_GAP=10
PORTAL_SYNC_TIMEOUT=10
PORTAL_SYNC_RETRIES=2
PORTAL_SYNC_BACKOFF=1.0
PORTAL_SYNC_STALE=180
PORTAL_SYNC_PAGE_SIZE=100
PORTAL_LINKS_ENABLED=1

# ---------- 身份与会话（阶段 3）----------
AUTH_RECHECK_INTERVAL=300
AUTH_RECHECK_GRACE=300
AUTH_WS_RECHECK=30
AUTH_SESSION_MEMBER_TTL=43200
AUTH_SESSION_EMERGENCY_TTL=28800
AUTH_EMERGENCY_MAX_FAIL=5
AUTH_EMERGENCY_LOCK_SEC=60

# ---------- 硬件（烧录/调试）----------
# 默认行为（与旧调试台一致，130 实测可用）：
#   USB 烧录走 PATH 里的 openocd（系统包 0.11）；TCP-DAP（无线）走
#   OPENOCD_TCP_BIN 默认值 /opt/openocd-vllink/bin/openocd（0.12+，TCP-DAP 需要）。
# 若希望 USB 也统一用 fork 构建，取消下行注释（需确认 USB 路径实测无回归）：
# OPENOCD_BIN=/opt/openocd-vllink/bin/openocd
OPENOCD_TCP_BIN=/opt/openocd-vllink/bin/openocd
OPENOCD_SCRIPTS=/usr/share/openocd/scripts
FLASH_TIMEOUT=180
# 内网扫描接口（POST /api/v2/devices/scan）限定网段；不设则自动取本机 /24
SCAN_SUBNET=192.168.1
