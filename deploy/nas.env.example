# NAS 容器部署的环境变量样例
#
# 用法：复制到仓库根部的 .env（chmod 600），按实际值填写。
# 该文件**不入库**：真实 App Secret 只存在于 NAS 上的 .env。
# 键名与默认值全部对应 app/config.py；其余可选键见 deploy/portal.env.example。

# ---------- 服务 ----------
# 宿主机映射端口（compose.yaml 的 ports 用它）；容器内部固定 8000
WEB_PORT=8000
WEB_HOST=0.0.0.0

# ---------- 构建 ----------
# 基础镜像默认用官方地址；NAS 的镜像加速器对 docker.io 返回 401 时改成本机拉得到的等价地址，
# 例：PYTHON_IMAGE=docker.cn-hangzhou.aliyuncs.com/library/python:3.10-slim
PYTHON_IMAGE=python:3.10-slim

# ---------- 前端 ----------
# vue = 使用 static/app/ 构建产物（仓库里已含，NAS 不装 node）
PORTAL_FRONTEND=vue

# ---------- 飞书（企业自建应用）----------
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# 只放这里；不要写进 config/feishu.json，也不要粘进文档或截图
FEISHU_APP_SECRET=请填写真实密钥
# 必须与开放平台「安全设置 → 重定向 URL」逐字一致（含协议与端口），否则回调 code=2000
# 例：http://192.168.1.50:8000/auth/feishu/callback 或 https://foray.example.com/auth/feishu/callback
FEISHU_REDIRECT_URL=http://<NAS地址>:8000/auth/feishu/callback
# 组织校验：必须是本战队的 tenant_key，留空则拒绝所有飞书登录
FEISHU_ALLOWED_TENANT_KEYS=

# ---------- 门户同步 ----------
PORTAL_SYNC_ENABLED=1
PORTAL_SYNC_INTERVAL=60
PORTAL_SYNC_STALE=180

# ---------- 内网扫描（容器内务必显式填，否则取到的是 docker 网段）----------
# 例：SCAN_SUBNET=192.168.1
SCAN_SUBNET=

# ---------- 反向代理 ----------
# 只有 NAS 上有反代容器时才需要：填反代容器地址，否则保持 127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1
